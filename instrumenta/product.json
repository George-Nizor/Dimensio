{
  "schemaVersion": 2,
  "id": "dimensio",
  "name": "Dimensio",
  "description": "A Blender course, and a Workshop where Claude Code or Codex builds models from a prompt.",
  "version": "0.4.0",
  "repository": {
    "provider": "github",
    "owner": "George-Nizor",
    "name": "Dimensio",
    "channel": "stable"
  },
  "platforms": ["windows-x64"],
  "adapter": {
    "type": "managed-bundle",
    "releaseManifestAsset": "instrumenta-release.json",
    "launch": {
      "candidates": ["desktop/dist-package/win-unpacked/Dimensio.exe"]
    }
  },
  "build": {
    "output": "desktop/dist-package"
  },
  "developer": {
    "checkout": "../Dimensio",
    "override": "explicit"
  },
  "assets": {
    "mark": "desktop/assets/brand/dimensio-app-art.png"
  },
  "mcp": {
    "skill": "plugins/dimensio/skills/dimensio/SKILL.md"
  }
}